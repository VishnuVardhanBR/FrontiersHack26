  "interactions": [
    {
      "id": "open_scroll_chest",
      "type": "chest_open",
      "targetObject": "missing_scroll_chest",
      "playerAction": "open chest and take sealed_scroll",
      "preconditions": [],
      "result": {
        "inventoryAdd": ["sealed_scroll"],
        "flagsSet": ["has_scroll"],
        "oneTimeOnly": true
      },
      "feedback": {
        "visual": "chest opens",
        "audio": "chest_open",
        "tutorOptionalLine": "That scroll stands in for a copied text. In the ancient world, knowledge survived because people preserved and recopied it."
      }
    },
    {
      "id": "place_scroll_on_pedestal",
      "type": "item_place",
      "targetObject": "archive_pedestal",
      "playerAction": "use sealed_scroll on pedestal",
      "preconditions": ["flag:has_scroll == true"],
      "result": {
        "pedestalState": "scroll_restored",
        "flagsSet": ["scroll_restored"],
        "inventoryRemove": ["sealed_scroll"]
      },
      "feedback": {
        "visual": "scroll appears on pedestal",
        "audio": "soft_chime",
        "particle": "optional_small_glow"
      }
    },
    {
      "id": "open_archive_door",
      "type": "state_trigger",
      "targetObject": "seal_door",
      "playerAction": "automatic after pedestal restored",
      "preconditions": ["flag:scroll_restored == true"],
      "result": {
        "doorState": "open",
        "flagsSet": ["archive_open"],
        "activateObjects": ["seal_glow_frame", "hidden_glow_blocks"]
      },
      "feedback": {
        "visual": "sealed door opens and chamber glows",
        "audio": "stone_shift",
        "cameraFriendly": true
      }
    },
    {
      "id": "enter_knowledge_chamber",
      "type": "proximity_trigger",
      "targetObject": "knowledge_chamber",
      "playerAction": "walk through opened door",
      "preconditions": ["flag:archive_open == true"],
      "result": {
        "flagsSet": ["reward_seen"]
      },
      "feedback": {
        "visual": "archive core comes into full view",
        "audio": "lantern_hum_optional"
      }
    }
  ],
  "objectives": {
    "primary": {
      "id": "restore_knowledge",
      "description": "Restore the missing scroll to the archive pedestal to unlock the knowledge chamber.",
      "successConditions": [
        "flag:scroll_restored == true",
        "flag:archive_open == true"
      ]
    },
    "secondary": [
      {
        "id": "observe_library_stacks",
        "description": "Follow the tutor to the main stacks and learn how texts were stored and copied.",
        "optional": true
      },
      {
        "id": "enter_reward_chamber",
        "description": "Walk into the opened chamber and view the restored archive.",
        "optional": true
      }
    ]
  },
