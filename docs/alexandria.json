    "flags": {
      "player_near_intro": false,
      "visited_shelf_stop": false,
      "has_scroll": false,
      "scroll_restored": false,
      "archive_open": false,
      "reward_seen": false
    },
    "timers": {
      "hintDelaySeconds": 8,
      "doorOpenDelayMs": 700,
      "successDialogueDelayMs": 1000
    }
  },
  "tutor": {
    "id": "alex_guide",
    "name": "Alex",
    "entityType": "mineflayer_bot",
    "spawn": { "x": 2, "y": 8, "z": 0 },
    "movementMode": "hardcoded_waypoints",
    "waypoints": [
      { "id": "intro", "position": { "x": 1, "y": 8, "z": 2 } },
      { "id": "shelves", "position": { "x": 0, "y": 8, "z": 8 } },
      { "id": "pedestal", "position": { "x": 2, "y": 8, "z": 14 } },
      { "id": "door_view", "position": { "x": 2, "y": 8, "z": 19 } },
      { "id": "final_view", "position": { "x": 1, "y": 8, "z": 24 } }
    ],
    "behaviorRules": {
      "neverFreeRoam": true,
      "neverLeaveMainPath": true,
      "speakInShortLines": true,
      "maxLineSeconds": 6,
      "waitForPlayerAtStops": true,
      "hintOnlyIfStalled": true
    },
    "dialogueScript": [
      {
        "id": "intro_1",
        "trigger": "player within 4 blocks of introStand",
        "action": "speak",
        "text": "Welcome to the Lost Library. Here, knowledge was precious because every text had to be preserved by people, one copy at a time."
      },
      {
        "id": "intro_move",
        "trigger": "after intro_1",
        "action": "move",
        "targetWaypoint": "shelves"
      },
      {
        "id": "shelves_1",
        "trigger": "tutor reaches shelves and player within 5 blocks",
        "action": "speak",
        "text": "Libraries were more than buildings full of books. They were places where ideas were stored, organized, and copied so they would not disappear."
      },
      {
        "id": "shelves_2",
        "trigger": "after shelves_1",
        "action": "speak",
        "text": "If even one important text was lost, future readers might never recover it."
      },
      {
        "id": "question_1",
        "trigger": "after shelves_2",
        "action": "askQuestion",
        "question": {
          "id": "why_copy_texts",
          "prompt": "Why did ancient texts need to be copied by hand?",
          "acceptableAnswers": [
            "to preserve them",
            "so they would survive",
            "to make more copies",
            "because there were no printers"
          ],
          "fallbackMode": "rhetorical_if_no_answer_after_5s",
          "explanationOnResolve": "Exactly. Copying helped texts survive and spread to new readers."
        }
      },
      {
        "id": "move_to_pedestal",
        "trigger": "after question_1",
        "action": "move",
        "targetWaypoint": "pedestal"
      },
      {
        "id": "pedestal_1",
        "trigger": "tutor reaches pedestal and player within 5 blocks",
        "action": "speak",
        "text": "This archive is sealed because one key scroll is missing. Restore it to the pedestal and the chamber will open."
      },
      {
        "id": "pedestal_2",
        "trigger": "after pedestal_1",
        "action": "speak",
        "text": "Take the scroll from the chest and place it here."
      },
      {
        "id": "hint_if_stalled_1",
        "trigger": "8 seconds after pedestal_2 if flag:has_scroll == false",
        "action": "speak",
        "text": "The scroll you need is in the chest beside the pedestal."
      },
      {
        "id": "hint_if_stalled_2",
        "trigger": "8 seconds after has_scroll if flag:scroll_restored == false",
        "action": "speak",
        "text": "Now place the scroll on the central pedestal to restore the archive."
      },
      {
        "id": "success_1",
        "trigger": "flag:archive_open == true",
        "action": "speak",
        "text": "Well done. Preserving knowledge let later generations build on earlier discoveries instead of starting over."
      },
      {
        "id": "success_move",
        "trigger": "after success_1",
        "action": "move",
        "targetWaypoint": "final_view"
      },
      {
        "id": "success_2",
        "trigger": "tutor reaches final_view and player within 6 blocks",
        "action": "speak",
        "text": "That is why libraries mattered so much. They protected memory, learning, and the spread of ideas."
      },
      {
        "id": "question_2",
        "trigger": "after success_2",
        "action": "askQuestion",
        "question": {
          "id": "why_libraries_matter",
          "prompt": "Quick check: what did libraries help preserve — only objects, or ideas too?",
          "acceptableAnswers": [
            "ideas too",
            "ideas",
            "knowledge",
            "both"
          ],
          "fallbackMode": "auto_resolve_after_4s",
          "explanationOnResolve": "Right. Libraries preserved ideas by preserving texts."
        }
      }
    ]
  },
  "questions": [
    {
      "id": "why_copy_texts",
      "timing": "mid_demo",
      "prompt": "Why did ancient texts need to be copied by hand?",
      "answerType": "short_free_response_or_rhetorical",
      "correctConcepts": [
        "preservation",
        "survival of texts",
        "sharing knowledge",
        "no printing technology"
      ],
      "explanation": "Without printing, a text could vanish unless someone copied it carefully."
    },
    {
      "id": "why_libraries_matter",
      "timing": "end_demo",
      "prompt": "What did libraries help preserve — only objects, or ideas too?",
      "answerType": "short_free_response_or_rhetorical",
      "correctConcepts": [
        "ideas",
        "knowledge",
        "memory of civilizations"
      ],
      "explanation": "Libraries preserved ideas by storing and organizing written works."
    }
  ],
  "renderingNotes": {
    "mustLookGoodFromSpawn": true,
    "spawnSightline": [
      "entry columns frame the stacks",
      "pedestal is visible beyond the shelves",
      "sealed door glow is faintly visible in distance"
    ],
    "lightingPlan": {
      "entry": "dim but readable",
      "stacks": "warm torch light",
      "pedestal": "slightly brighter focal spot",
      "knowledgeChamber": "dark at start, glows on success"
    },
    "emptySpacePolicy": "avoid large unused floor patches; fill corners with rubble, shelves, columns, or trim",
    "cameraPayoffMoment": "door opens and hidden glow activates immediately after pedestal restoration"
  },
  "implementationHints": {
    "bestPuzzleImplementation": "use chest item retrieval + pedestal proximity/item-use event, not a complex inventory puzzle",
    "bestDoorImplementation": "swap blocking blocks to air and enable hidden lights instead of relying on animated doors",
    "bestSuccessEffect": "activate glow blocks and tutor success line within 1 second of placing the scroll",
    "avoid": [
      "randomized puzzle variants",
      "freeform tutor generation during the demo",
      "large maze-like shelf layouts",
      "multiple items or wrong answers that slow down the demo"
    ]
  },
  "successMetrics": {
    "targetCompletionTimeSeconds": 75,
    "acceptableCompletionTimeSeconds": 105,
    "playerShouldUnderstand": [
      "texts were copied by hand",
      "libraries preserved knowledge",
      "restoring the scroll symbolizes preserving ideas"
    ],
    "demoLooksSuccessfulIf": [
      "tutor stays on same Y-level as player",
      "player never gets lost",
      "pedestal interaction works on first try",
      "archive opening is visually obvious"
    ]
  }
}

